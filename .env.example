# .env.example — contains NO real credentials. Copy it:  cp .env.example .env
# then fill in your own values in .env (which is git-ignored and never committed).

# --- LLM provider ---
# gemini (Google AI Studio, free tier) | scripted (offline, no key)
LLM_PROVIDER=gemini

# --- Google Gemini ---
# Create a free key at https://aistudio.google.com/apikey  (no credit card)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Model id; gemini-flash-latest always points at the current Flash model
GEMINI_MODEL=gemini-flash-latest

# true forces the offline scripted LLM (overrides LLM_PROVIDER)
USE_SCRIPTED_LLM=false

# --- Transit data ---
# GTFS zip or unzipped folder. Default: the small sample network in data/sample/mini-gtfs.
# For the real TTC network download "TTC Routes and Schedules" from open.toronto.ca to data/local/.
GTFS_PATH=data/sample/mini-gtfs
TTC_FEED_BASE_URL=https://bustime.ttc.ca/gtfsrt

# Where agent steps are logged (JSON lines, used as KUMA evidence in Stage 3)
TRACE_FILE=trace.jsonl
