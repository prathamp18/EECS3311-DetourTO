  <element>
    <id>UMLNote</id>
    <coordinates><x>716</x><y>60</y><w>390</w><h>80</h></coordinates>
    <panel_attributes>Subject: EventBus.publish() notifies every
subscribed listener. Publishers (AlertService,
TripMonitorService, agents) never reference
the GUI, the console or the trace file.</panel_attributes>
    <additional_attributes/>
