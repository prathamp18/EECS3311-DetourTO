<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="15.1">
  <zoom_level>10</zoom_level>
  <element>
    <id>Text</id>
    <coordinates><x>10</x><y>10</y><w>1200</w><h>40</h></coordinates>
    <panel_attributes>fontsize=16
*Observer — EventBus and EventListener*</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>360</x><y>320</y><w>420</w><h>130</h></coordinates>
    <panel_attributes>«Subject»
EventBus
--
- listeners : Map&lt;EventType, List&lt;EventListener&gt;&gt;
--
+ subscribe(type: EventType, l: EventListener)
+ unsubscribe(type: EventType, l: EventListener)
+ publish(e: TransitEvent)</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>330</x><y>525</y><w>230</w><h>80</h></coordinates>
    <panel_attributes>«interface»
/EventListener/
--
--
+ onEvent(e: TransitEvent)</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>730</x><y>515</y><w>190</w><h>100</h></coordinates>
    <panel_attributes>TransitEvent
--
- type : EventType
- payload : Object
- timestamp : Instant
--</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>870</x><y>680</y><w>170</w><h>160</h></coordinates>
    <panel_attributes>«enumeration»
EventType
--
ALERTS_UPDATED
ITINERARY_UPDATED
TRIP_STATE_CHANGED
TRIP_AT_RISK
LEAVE_BY_ALERT
AGENT_STEP</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>20</x><y>695</y><w>270</w><h>130</h></coordinates>
    <panel_attributes>«Observer»
/BasePanel/
--
# controller : TripController
--
+ onEvent(e: TransitEvent)
/+ render()/
# runOnFxThread(task: Runnable)</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>330</x><y>710</y><w>230</w><h>100</h></coordinates>
    <panel_attributes>«Observer»
ConsoleNotifier
--
- out : PrintStream
--
+ onEvent(e: TransitEvent)</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>600</x><y>710</y><w>230</w><h>100</h></coordinates>
    <panel_attributes>«Observer»
TraceLogger
--
- traceFile : Path
--
+ onEvent(e: TransitEvent)</panel_attributes>
    <additional_attributes/>
  </element>
