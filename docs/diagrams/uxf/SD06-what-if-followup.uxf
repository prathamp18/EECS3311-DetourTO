    <panel_attributes>title=SD06 — What-If Follow-up with Undo (F10 / UC11, UC16, UC18)
obj=:Rider~R ACTOR
obj=_:TripPlannerPanel_~UI
obj=_:TripController_~TC
obj=_:TripRequestAgent_~AG
