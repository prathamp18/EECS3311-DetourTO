TC-&gt;&gt;&gt;H : undo(); on=H
combinedFragment=alt~f2 UI JP
UI:[undoStack not empty]
H-&gt;&gt;&gt;C : undo(); on=C
C-&gt;&gt;&gt;Q : departAt = oldTime; off=C
H.&gt;TC : true
TC-&gt;&gt;&gt;JP : plan(q, ds, strategy)
