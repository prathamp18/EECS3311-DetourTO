<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="15.1">
  <zoom_level>10</zoom_level>
  <element>
    <id>Text</id>
    <coordinates><x>10</x><y>10</y><w>1200</w><h>40</h></coordinates>
    <panel_attributes>fontsize=16
*Class Diagram — Domain Layer (transit network, planner, strategies, disruptions)*</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>674</x><y>785</y><w>530</w><h>180</h></coordinates>
    <panel_attributes>TransitNetwork
--
- stops : Map&lt;String, Stop&gt;
- routes : Map&lt;String, Route&gt;
- trips : Map&lt;String, Trip&gt;
- transfers : List&lt;Transfer&gt;
--
+ stopById(id: String): Stop
+ stopsNear(lat: double, lon: double, radiusM: int): List&lt;Stop&gt;
+ withDisruptions(ds: List&lt;Disruption&gt;): NetworkView
+ replaceWith(other: TransitNetwork)</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>724</x><y>1030</y><w>430</w><h>150</h></coordinates>
    <panel_attributes>NetworkView
--
- base : TransitNetwork
- closedStopIds : Set&lt;String&gt;
- closedRouteIds : Set&lt;String&gt;
- outageStopIds : Set&lt;String&gt;
--
+ isUsable(t: Trip, from: Stop, to: Stop): boolean
+ isStepFree(s: Stop): boolean</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>497</x><y>1480</y><w>270</w><h>150</h></coordinates>
    <panel_attributes>Stop
--
- id : String
- name : String
- lat : double
- lon : double
- wheelchairBoarding : boolean
- parentStation : String [0..1]
--</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>1445</x><y>1270</y><w>190</w><h>120</h></coordinates>
    <panel_attributes>Route
--
- id : String
- shortName : String
- longName : String
- mode : TransitMode
--</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>412</x><y>1055</y><w>190</w><h>100</h></coordinates>
    <panel_attributes>Trip
--
- id : String
- serviceId : String
- headsign : String
--</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>412</x><y>1280</y><w>210</w><h>100</h></coordinates>
    <panel_attributes>StopTime
--
- arrival : LocalTime
- departure : LocalTime
- sequence : int
--</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>662</x><y>1295</y><w>170</w><h>70</h></coordinates>
    <panel_attributes>Transfer
--
- minSeconds : int
--</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>1475</x><y>1490</y><w>130</w><h>130</h></coordinates>
    <panel_attributes>«enumeration»
TransitMode
--
SUBWAY
STREETCAR
BUS
WALK</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>1115</x><y>85</y><w>700</w><h>150</h></coordinates>
    <panel_attributes>JourneyPlanner
--
- network : TransitNetwork
- maxRounds : int = 5
--
+ plan(q: TripQuery, ds: List&lt;Disruption&gt;, s: RouteScoringStrategy): List&lt;Itinerary&gt;
+ scheduledDepartures(stopId: String, from: LocalDateTime, n: int): List&lt;Arrival&gt;
- raptorRounds(q: TripQuery, view: NetworkView, s: RouteScoringStrategy): ParetoSet
- reconstruct(p: ParetoSet): List&lt;Itinerary&gt;</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>1115</x><y>1245</y><w>290</w><h>170</h></coordinates>
    <panel_attributes>TripQuery
--
- origin : Stop
- destination : Stop
- departAt : LocalDateTime [0..1]
- arriveBy : LocalDateTime [0..1]
- strategyKind : StrategyKind
- avoidRouteIds : Set&lt;String&gt;
- maxWalkMeters : int = 800
--</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>1185</x><y>1490</y><w>150</w><h>130</h></coordinates>
    <panel_attributes>«enumeration»
StrategyKind
--
FASTEST
FEWEST_TRANSFERS
LEAST_WALKING
ACCESSIBLE</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>1726</x><y>355</y><w>540</w><h>120</h></coordinates>
    <panel_attributes>«interface»
/RouteScoringStrategy/
--
--
+ admissible(leg: Leg, q: TripQuery, view: NetworkView): boolean
+ score(i: Itinerary): double
+ label(): String</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>1395</x><y>595</y><w>540</w><h>100</h></coordinates>
    <panel_attributes>FastestStrategy
--
--
+ admissible(leg: Leg, q: TripQuery, view: NetworkView): boolean
+ score(i: Itinerary): double
+ label(): String</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>1477</x><y>815</y><w>540</w><h>120</h></coordinates>
    <panel_attributes>FewestTransfersStrategy
--
- transferPenaltyMin : int = 10
--
+ admissible(leg: Leg, q: TripQuery, view: NetworkView): boolean
+ score(i: Itinerary): double
+ label(): String</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>1808</x><y>1045</y><w>540</w><h>120</h></coordinates>
    <panel_attributes>LeastWalkingStrategy
--
- walkWeight : double = 3.0
--
+ admissible(leg: Leg, q: TripQuery, view: NetworkView): boolean
+ score(i: Itinerary): double
+ label(): String</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>2139</x><y>1280</y><w>540</w><h>100</h></coordinates>
    <panel_attributes>AccessibleStrategy
--
--
+ admissible(leg: Leg, q: TripQuery, view: NetworkView): boolean
+ score(i: Itinerary): double
+ label(): String</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>463</x><y>325</y><w>250</w><h>180</h></coordinates>
    <panel_attributes>Itinerary
--
- id : String
- legs : List&lt;Leg&gt;
--
+ departure(): LocalDateTime
+ arrival(): LocalDateTime
+ durationMinutes(): int
+ transfers(): int
+ walkMeters(): int
+ routeIds(): Set&lt;String&gt;</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>324</x><y>570</y><w>210</w><h>150</h></coordinates>
