    <panel_attributes>ServiceAlert
--
- id : String
- header : String
- description : String
- informedRouteIds : List&lt;String&gt;
- informedStopIds : List&lt;String&gt;
- activeFrom : Instant
- activeTo : Instant [0..1]
--</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>2996</x><y>60</y><w>280</w><h>200</h></coordinates>
    <panel_attributes>Disruption
--
- id : String
- sourceAlertId : String
- kind : DisruptionKind
- affectedRouteIds : Set&lt;String&gt;
- closedStopIds : Set&lt;String&gt;
- start : LocalDateTime
- end : LocalDateTime [0..1]
- confidence : double
- llmDerived : boolean
--</panel_attributes>
    <additional_attributes/>
  </element>
