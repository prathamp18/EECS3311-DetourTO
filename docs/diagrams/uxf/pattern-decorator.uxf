  <element>
    <id>UMLClass</id>
    <coordinates><x>450</x><y>60</y><w>350</w><h>120</h></coordinates>
    <panel_attributes>«interface»
/RealtimeFeed/
--
--
+ alerts(): List&lt;ServiceAlert&gt;
+ snapshot(): RealtimeSnapshot
+ arrivals(stopId: String): List&lt;Arrival&gt;</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>20</x><y>245</y><w>390</w><h>180</h></coordinates>
    <panel_attributes>«Adapter»
GtfsRealtimeAdapter
--
- http : HttpClient
- baseUrl : String
--
+ alerts(): List&lt;ServiceAlert&gt;
+ snapshot(): RealtimeSnapshot
+ arrivals(stopId: String): List&lt;Arrival&gt;
- fetch(path: String): FeedMessage
- toServiceAlert(e: FeedEntity): ServiceAlert</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>450</x><y>270</y><w>350</w><h>130</h></coordinates>
    <panel_attributes>«Decorator»
/RealtimeFeedDecorator/
--
# inner : RealtimeFeed
--
+ alerts(): List&lt;ServiceAlert&gt;
+ snapshot(): RealtimeSnapshot
+ arrivals(stopId: String): List&lt;Arrival&gt;</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>305</x><y>490</y><w>310</w><h>130</h></coordinates>
    <panel_attributes>CachingRealtimeFeed
--
- ttl : Duration
- cachedAlerts : List&lt;ServiceAlert&gt;
- fetchedAt : Instant
--
+ alerts(): List&lt;ServiceAlert&gt;
+ snapshot(): RealtimeSnapshot</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>655</x><y>495</y><w>270</w><h>120</h></coordinates>
    <panel_attributes>ResilientRealtimeFeed
--
- breaker : CircuitBreaker
- lastGood : RealtimeSnapshot
--
+ alerts(): List&lt;ServiceAlert&gt;
+ snapshot(): RealtimeSnapshot</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>675</x><y>685</y><w>230</w><h>180</h></coordinates>
    <panel_attributes>CircuitBreaker
--
- status : BreakerStatus
- failures : int
- threshold : int = 3
- cooldown : Duration
- openedAt : Instant
--
+ allowRequest(): boolean
+ recordSuccess()
+ recordFailure()</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLNote</id>
    <coordinates><x>840</x><y>80</y><w>310</w><h>80</h></coordinates>
    <panel_attributes>Runtime chain built once at startup:
new CachingRealtimeFeed(
  new ResilientRealtimeFeed(
    new GtfsRealtimeAdapter(url)))</panel_attributes>
    <additional_attributes/>
