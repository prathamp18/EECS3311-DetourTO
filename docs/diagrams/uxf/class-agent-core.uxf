  <element>
    <id>UMLClass</id>
    <coordinates><x>1009</x><y>60</y><w>580</w><h>280</h></coordinates>
    <panel_attributes>«Template Method»
/TransitAgent/
--
# llm : LLMClient
# tools : ToolRegistry
# parser : ResponseParser
# validator : GroundingValidator
# eventBus : EventBus
# maxToolRounds : int = 6
--
+ run(req: AgentRequest): AgentResult
# buildMessages(req: AgentRequest): List&lt;Message&gt;
/# systemPrompt(): String/
/# toolNames(): List&lt;String&gt;/
/# parseFinal(r: LLMResponse, ctx: AgentContext): Object/
/# validate(output: Object, ctx: AgentContext): ValidationReport/
# onInvalid(report: ValidationReport, req: AgentRequest): AgentResult</panel_attributes>
    <additional_attributes/>
  </element>
