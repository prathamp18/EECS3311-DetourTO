  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>60</x><y>275</y><w>390</w><h>180</h></coordinates>
    <panel_attributes>«Adapter»
GtfsRealtimeAdapter
--
- http : HttpClient
- baseUrl : String
--
+ alerts(): List&lt;ServiceAlert&gt;
+ snapshot(): RealtimeSnapshot
+ arrivals(stopId: String): List&lt;Arrival&gt;
- fetch(path: String): FeedMessage
- toServiceAlert(e: FeedEntity): ServiceAlert</panel_attributes>
