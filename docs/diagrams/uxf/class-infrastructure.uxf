    <coordinates><x>20</x><y>535</y><w>370</w><h>100</h></coordinates>
    <panel_attributes>«Adaptee (gtfs-realtime-bindings)»
FeedMessage
--
--
+ getEntityList(): List&lt;FeedEntity&gt;
_+ parseFrom(in: InputStream): FeedMessage_</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>490</x><y>300</y><w>350</w><h>130</h></coordinates>
