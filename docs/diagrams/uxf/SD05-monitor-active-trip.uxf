    <panel_attributes>title=SD05 — Monitor Active Trip (F07 / UC08, extended by UC06)
obj=:Rider~R ACTOR
obj=_:TripPlannerPanel_~UI
obj=_:TripController_~TC
obj=_:TripMonitorService_~MON
obj=_trip:ActiveTrip_~AT CREATED_LATER
