R-&gt;&gt;&gt;UI : onStartTripClicked(); on=UI
UI-&gt;&gt;&gt;TC : startTrip(itineraryId); on=TC
TC-&gt;&gt;&gt;MON : start(i); on=MON
MON-&gt;&gt;&gt;AT : «create»(i, new PlannedState())
MON.&gt;TC : trip; off=MON
TC.&gt;UI : trip; off=TC; off=UI
combinedFragment=loop~f1 R CN
R:[every pollSeconds until trip state is CompletedState]
MON-&gt;MON + : poll(); on=MON
MON-&gt;&gt;&gt;FEED : snapshot()
FEED.&gt;MON : RealtimeSnapshot
MON-&gt;&gt;&gt;AS : currentDisruptions()
AS.&gt;MON : List&lt;Disruption&gt;
MON-&gt;&gt;&gt;AT : update(snap, ds); on=AT
AT-&gt;&gt;&gt;ST : handle(this, snap, ds); on=ST
combinedFragment=alt~f2 AT ST
AT:[disruption on a remaining leg, or projected arrival &gt; arriveBy]
ST-&gt;&gt;&gt;AT : setState(new AtRiskState())
..=f2
AT:[delays within slack]
ST-&gt;&gt;&gt;AT : setState(new OnTrackState())
..=f2
AT:[final leg finished]
ST-&gt;&gt;&gt;AT : setState(new CompletedState())
--=f2; off=ST; off=AT
MON-&gt;&gt;&gt;AT : getState()
AT.&gt;MON : state
MON-&gt;&gt;&gt;EB : publish(TRIP_STATE_CHANGED)
combinedFragment=opt~f3 R CN
R:[state is AtRiskState]
MON-&gt;&gt;&gt;EB : publish(TRIP_AT_RISK); on=EB
EB-&gt;&gt;&gt;UI : onEvent(e)
EB-&gt;&gt;&gt;CN : onEvent(e); off=EB
UI.&gt;R : "Line 1 closed at St George. Re-route?"
