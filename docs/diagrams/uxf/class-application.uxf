<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<diagram program="umlet" version="15.1">
  <zoom_level>10</zoom_level>
  <element>
    <id>Text</id>
    <coordinates><x>10</x><y>10</y><w>1200</w><h>40</h></coordinates>
    <panel_attributes>fontsize=16
*Class Diagram — Application Layer (facade, events, commands, trip monitoring)*</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>2835</x><y>60</y><w>500</w><h>560</h></coordinates>
    <panel_attributes>«Facade»
TripController
--
- planner : JourneyPlanner
- places : PlaceResolver
- strategies : Map&lt;StrategyKind, RouteScoringStrategy&gt;
- tripAgent : TripRequestAgent
- explainAgent : ExplanationAgent
- preferenceAgent : PreferenceExtractorAgent
- alertService : AlertService
- monitor : TripMonitorService
- commuteScheduler : CommuteScheduler
- profiles : ProfileRepository
- history : CommandHistory
- commandFactory : QueryCommandFactory
- eventBus : EventBus
- session : ConversationSession
--
+ planFromText(text: String, at: LocalDateTime): PlanResult
+ planFromForm(q: TripQuery): PlanResult
+ setStrategy(kind: StrategyKind): PlanResult
+ followUp(text: String): PlanResult
+ undo(): PlanResult
+ redo(): PlanResult
+ explain(): Explanation
+ getAlerts(): List&lt;Disruption&gt;
+ rerouteAround(d: Disruption): PlanResult
+ startTrip(itineraryId: String): ActiveTrip
+ acceptReroute(tripId: String): PlanResult
+ getArrivals(stopQuery: String): List&lt;Arrival&gt;
+ savePlace(label: String, stopQuery: String)
+ saveCommute(c: Commute)
+ runReplay(s: ReplayScenario): BenchmarkReport
+ refreshTransitData(): FeedValidationReport</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>627</x><y>720</y><w>390</w><h>130</h></coordinates>
    <panel_attributes>PlanResult
--
- query : TripQuery
- options : List&lt;Itinerary&gt;
- clarification : ClarificationRequest [0..1]
- disruptionsApplied : List&lt;Disruption&gt;
- message : String
--</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>682</x><y>990</y><w>370</w><h>120</h></coordinates>
    <panel_attributes>ConversationSession
--
- conversation : ConversationHistory
- currentQuery : TripQuery [0..1]
- lastOptions : List&lt;Itinerary&gt;
--
+ rememberOptions(options: List&lt;Itinerary&gt;)</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>950</x><y>1215</y><w>420</w><h>130</h></coordinates>
    <panel_attributes>«Subject»
EventBus
--
- listeners : Map&lt;EventType, List&lt;EventListener&gt;&gt;
--
+ subscribe(type: EventType, l: EventListener)
+ unsubscribe(type: EventType, l: EventListener)
+ publish(e: TransitEvent)</panel_attributes>
