  <zoom_level>10</zoom_level>
  <element>
    <id>Text</id>
    <coordinates><x>10</x><y>10</y><w>1200</w><h>40</h></coordinates>
    <panel_attributes>fontsize=16
*Facade — TripController*</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLClass</id>
    <coordinates><x>103</x><y>310</y><w>500</w><h>560</h></coordinates>
    <panel_attributes>«Facade»
TripController
--
- planner : JourneyPlanner
- places : PlaceResolver
- strategies : Map&lt;StrategyKind, RouteScoringStrategy&gt;
- tripAgent : TripRequestAgent
- explainAgent : ExplanationAgent
- preferenceAgent : PreferenceExtractorAgent
- alertService : AlertService
- monitor : TripMonitorService
- commuteScheduler : CommuteScheduler
- profiles : ProfileRepository
- history : CommandHistory
- commandFactory : QueryCommandFactory
- eventBus : EventBus
- session : ConversationSession
--
+ planFromText(text: String, at: LocalDateTime): PlanResult
+ planFromForm(q: TripQuery): PlanResult
+ setStrategy(kind: StrategyKind): PlanResult
+ followUp(text: String): PlanResult
+ undo(): PlanResult
+ redo(): PlanResult
+ explain(): Explanation
+ getAlerts(): List&lt;Disruption&gt;
+ rerouteAround(d: Disruption): PlanResult
+ startTrip(itineraryId: String): ActiveTrip
+ acceptReroute(tripId: String): PlanResult
+ getArrivals(stopQuery: String): List&lt;Arrival&gt;
+ savePlace(label: String, stopQuery: String)
+ saveCommute(c: Commute)
+ runReplay(s: ReplayScenario): BenchmarkReport
+ refreshTransitData(): FeedValidationReport</panel_attributes>
    <additional_attributes/>
  </element>
