@startuml pattern-factory
!include _style.iuml
title Factory — LLMClientFactory and QueryCommandFactory
!include model.iuml
remove *
restore LLMClientFactory
restore LLMClient
restore BedrockClaudeAdapter
restore ScriptedLLMClient
restore AppConfig
restore QueryCommandFactory
restore QueryCommand
restore FollowUpIntent
hide AppConfig members
hide FollowUpIntent members
hide BedrockClaudeAdapter members
